{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "${description}",
  "authors": [
    "HCuadrado428"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/HCuadrado428/stormroot",
    "sources": "https://github.com/HCuadrado428/stormroot",
    "issues": "https://github.com/HCuadrado428/stormroot/issues"
  },
  "icon": "assets/${id}/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "${group}.${id}.Stormroot"
    ],
    "client": [
      "${group}.${id}.client.StormrootClient"
    ],
    "modmenu": [
      "${group}.${id}.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "stormroot.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": ">=${fabricVersion}",
    "minecraft": "${mcRangeFabric}"
  },
  "suggests": {
    "bloomberto": ">=0.2.0"
  }
}
